# Modelo da configuração local do Zé Praga.
# Copie para `.env.local` e preencha as três chaves vazias:
#   cp .env.local.example .env.local
# `.env.local` é ignorado pelo Git — nunca versione o arquivo preenchido.
#
# Tudo aqui roda na máquina, exceto OpenAI e Resend, que são serviços externos
# de verdade. O Supabase saiu de cena porque o projeto de produção não existe
# mais — banco e imagens ficam locais.

# ── Banco: Postgres com pgvector no Docker (projeto zepraga-ux-local) ────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ze_praga

# ── Imagens: disco local, servidas pela própria API com URL assinada ─────────
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=C:\Users\felip\Projects\tcc\backend\.local-storage

# Supabase não é usado no modo local; os valores existem só porque Settings
# os exige. Não aponte isto para um projeto real.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=local-nao-usado

# ── Agente: OpenAI real ─────────────────────────────────────────────────────
OPENAI_API_KEY=
CHAT_MODEL=openai:gpt-4o-mini
VISION_MODEL=openai:gpt-4o

# ── E-mail: Resend real ─────────────────────────────────────────────────────
# Atenção: `onboarding@resend.dev` é o remetente compartilhado de teste do
# Resend e **só entrega para o e-mail dono da conta**. Para mandar a qualquer
# destinatário é preciso verificar um domínio próprio no Resend e trocar o
# EMAIL_FROM. Por isso a verificação de e-mail fica desligada abaixo: com ela
# ligada, cadastrar qualquer outro endereço travaria o login.
RESEND_API_KEY=
EMAIL_FROM=Zé Praga <onboarding@resend.dev>
REQUIRE_EMAIL_VERIFICATION=false

# ── Inferência: ONNX real ───────────────────────────────────────────────────
INFERENCE_USE_ONNX=true
INFERENCE_ONNX_MODEL_PATH=models/soja_efficientnet_b4.onnx
INFERENCE_ONNX_INPUT_SIZE=380

# ── Rede ────────────────────────────────────────────────────────────────────
PUBLIC_API_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3101
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3100,http://127.0.0.1:3101,http://localhost:3000,http://localhost:3100,http://localhost:3101

# Estável entre reinícios: assina as URLs das imagens e os tokens de sessão.
JWT_SECRET_KEY=  # gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"

APP_ENV=development

# ── Rate limit ──────────────────────────────────────────────────────────────
# Localmente todo acesso vem de 127.0.0.1 e cai no mesmo balde: com o limite de
# produção (5 cadastros/hora) você se tranca sozinho ao criar a terceira conta.
RATE_LIMIT_LOGIN=100/300
RATE_LIMIT_REGISTER=100/3600
RATE_LIMIT_EMAIL=50/3600
RATE_LIMIT_RESET=100/3600
