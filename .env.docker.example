# ─────────────────────────────────────────────────────────────────────────────
# Configuração para rodar com Docker (banco local, sem Supabase)
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Copie este arquivo:   cp .env.docker.example .env
# 2. Suba os containers:   docker compose up --build
#
# O banco de dados PostgreSQL sobe automaticamente via docker-compose.
# O upload de imagens (Storage) não funciona neste modo — apenas o cadastro,
# login, diagnósticos e planos de ação estão disponíveis.
# ─────────────────────────────────────────────────────────────────────────────

# Banco de dados — aponta para o container "db" do docker-compose
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ze_praga

# Supabase — não é usado neste modo (Storage desativado)
SUPABASE_URL=http://placeholder-storage-disabled
SUPABASE_SERVICE_ROLE_KEY=placeholder-storage-disabled

# JWT — troque por uma string aleatória longa em produção
JWT_SECRET_KEY=local-dev-secret-mude-em-producao
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
