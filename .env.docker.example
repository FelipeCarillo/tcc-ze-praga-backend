# ─────────────────────────────────────────────────────────────────────────────
# Configuração para rodar com Docker (banco local, sem Supabase)
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Copie este arquivo:   cp .env.docker.example .env
# 2. Suba os containers:   docker compose up --build
#
# O banco de dados PostgreSQL sobe automaticamente via docker-compose.
# O upload de imagens (Storage) não funciona neste modo — apenas o cadastro,
# login, diagnósticos e planos de ação estão disponíveis.
# ─────────────────────────────────────────────────────────────────────────────

# Banco de dados — aponta para o container "db" do docker-compose
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ze_praga

# Supabase — não é usado neste modo (Storage desativado)
SUPABASE_URL=http://placeholder-storage-disabled
SUPABASE_SERVICE_ROLE_KEY=placeholder-storage-disabled

# JWT — troque por uma string aleatória longa em produção
JWT_SECRET_KEY=local-dev-secret-mude-em-producao
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── LLM (provider-agnostic via langchain.chat_models.init_chat_model) ─────────
# Formato: "<provider>:<model>". Providers suportados:
#   openai            → ex: openai:gpt-4o-mini, openai:gpt-4o
#   anthropic         → ex: anthropic:claude-3-5-sonnet-latest
#   bedrock_converse  → ex: bedrock_converse:anthropic.claude-3-5-sonnet-20240620-v1:0
#   azure_openai      → ex: azure_openai:gpt-4o
#   google_vertexai   → ex: google_vertexai:gemini-1.5-pro
#
# Em modo Docker o chatbot e a busca semantica nao sao caminho critico — o
# /diagnoses/analyze (CV mockado) sobe sem credenciais. So preencha as keys do
# provider escolhido se quiser exercitar o chat agent.
CHAT_MODEL=openai:gpt-4o-mini
VISION_MODEL=openai:gpt-4o

# OpenAI (default)
# OPENAI_API_KEY=sk-your-openai-key

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# AWS Bedrock
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_DEFAULT_REGION=us-east-1

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Google Vertex AI
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# App
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
