# Variáveis do backend no perfil enxuto (Cloud Run ou AWS Lambda).
# Copie para .env.cloud (ignorado pelo git) e preencha. Guia: DEPLOY-ENXUTO.md.

# Supabase — use o pooler em modo sessão (porta 5432, IPv4). O host direto
# db.<ref>.supabase.co só resolve em IPv6.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

JWT_SECRET_KEY=<string-aleatoria-de-64-caracteres>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM — gpt-4o-mini no agente. O gate de visão fica no gpt-4o com detail=low:
# a OpenAI cobra imagem no gpt-4o-mini com multiplicador (~2.833 tokens contra
# 85 no gpt-4o), então para foto o gpt-4o "low" é o mais barato. O diagnóstico
# é do ONNX; o LLM de visão só decide "é folha ou não".
# Planos Pro/Enterprise usam o llm_model gravado no banco (gpt-4o) — para a
# demonstração, deixe os usuários no plano Free.
OPENAI_API_KEY=sk-...
CHAT_MODEL=openai:gpt-4o-mini
VISION_MODEL=openai:gpt-4o
VISION_IMAGE_DETAIL=low
CHAT_TIMEOUT_SECONDS=45

# Busca na web (Tavily): só os planos Pro/Enterprise têm a tool. No Free, não
# precisa de chave.
# TAVILY_API_KEY=tvly-...

# Perfil enxuto
INFERENCE_MODELS=efficientnet_b4
CHAT_STREAMING_ENABLED=false
RUN_MIGRATIONS_ON_BOOT=false

# Cadastro fechado por e-mail
RESEND_API_KEY=re_...
EMAIL_FROM=Ze Praga <onboarding@resend.dev>
REQUIRE_EMAIL_VERIFICATION=true

APP_ENV=production
FRONTEND_URL=https://<seu-front>.vercel.app
PUBLIC_API_URL=https://<url-da-api>
ALLOWED_ORIGINS=https://<seu-front>.vercel.app
