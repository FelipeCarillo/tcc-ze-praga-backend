# Supabase PostgreSQL — direct connection for SQLAlchemy
# Found in: Supabase Dashboard > Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql+asyncpg://postgres:[password]@[host]:5432/postgres

# Supabase — used only for Storage bucket operations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── LLM (provider-agnostic via langchain.chat_models.init_chat_model) ─────────
# Formato: "<provider>:<model>". Providers suportados:
#   openai            → ex: openai:gpt-4o-mini, openai:gpt-4o
#   anthropic         → ex: anthropic:claude-3-5-sonnet-latest
#   bedrock_converse  → ex: bedrock_converse:anthropic.claude-3-5-sonnet-20240620-v1:0
#   azure_openai      → ex: azure_openai:gpt-4o
#   google_vertexai   → ex: google_vertexai:gemini-1.5-pro
#
# Cada provider precisa das suas variaveis de ambiente. Descomente o bloco do
# provider escolhido e remova/comente os outros.
CHAT_MODEL=openai:gpt-4o-mini
VISION_MODEL=openai:gpt-4o

# OpenAI (default)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# AWS Bedrock
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_DEFAULT_REGION=us-east-1

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Google Vertex AI
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Embeddings (ainda OpenAI — usado pelo AsyncPostgresStore do LangGraph)
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_EMBEDDINGS_DIMS=1536

# ─── V2 — multi-cultivo (default OFF) ───
# Ative quando quiser que o agente identifique cultivo automaticamente em imagens.
# Requer também plan.features.identify_crop_auto=true (tier Pro+).
AGENT_ENABLE_IDENTIFY_CROP=false

# ─── Inferência ONNX (TCC-023 / ADR-0003) ───
# Modelo real treinado (EfficientNet-B4 no dataset ASDID, ~98.8% top-1).
# Default ON; se o arquivo ou o onnxruntime faltarem, o InferenceService cai
# no mock automaticamente (graceful fallback).
INFERENCE_USE_ONNX=true
INFERENCE_ONNX_MODEL_PATH=models/soja_efficientnet_b4.onnx
INFERENCE_ONNX_INPUT_SIZE=380

# App
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
