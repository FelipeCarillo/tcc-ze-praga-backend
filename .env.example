# Supabase PostgreSQL — direct connection for SQLAlchemy
# Found in: Supabase Dashboard > Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql+asyncpg://postgres:[password]@[host]:5432/postgres

# Supabase — used only for Storage bucket operations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI — required for chat agent (LangGraph) features
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-5.4-mini

# ─── V2 — multi-cultivo (default OFF) ───
# Ative quando quiser que o agente identifique cultivo automaticamente em imagens.
# Requer também plan.features.identify_crop_auto=true (tier Pro+).
AGENT_ENABLE_IDENTIFY_CROP=false
OPENAI_VISION_MODEL=gpt-4o

# App
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
